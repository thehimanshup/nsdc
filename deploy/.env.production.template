# =========================================================
# PRODUCTION environment template — Government Services Platform
# Copy to the server as `.env` (chmod 600) and fill in real values.
# The server REFUSES to boot in production if the critical values below
# are missing/wrong (see backend startup validation + PRODUCTION_READINESS.md).
# NEVER commit the filled-in file to git.
# =========================================================

# ---- Deployment profile (production lockdown) ----
APP_ENV=production
PRODUCTION_MODE=true
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_ROUTES=false
AUTO_SEED_CORPORA=false
PUSH_DEMO_ENABLED=false
REQUIRE_LIVE_INTEGRATIONS=true        # set true only once Twilio + LiveKit are wired
REQUIRE_AUTH=true
ADMIN_API_TOKEN=__CHANGE_ME__strong-random-token__   # e.g. `openssl rand -hex 32`

# ---- Server binding ----
# Bind to loopback: nginx / IIS-ARR is the only thing that talks to uvicorn,
# and the ZTNA connector talks to the reverse proxy — never expose uvicorn directly.
HOST=127.0.0.1
PORT=8000
DATA_DIR=/opt/govapp/phase6e/data     # WINDOWS: C:\govapp\phase6e\data
ENABLE_STREAMING=true
ENABLE_INTENT_ROUTER=true

# ---- LLM Provider (sovereign default) ----
LLM_PROVIDER=sarvam
SARVAM_API_KEY=__CHANGE_ME__
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_ROUTER_MODEL=sarvam-30b
SARVAM_VERIFY_SSL=true
# SARVAM_CA_BUNDLE=/etc/ssl/corp-ca.pem   # only if behind a TLS-inspecting proxy

# ---- Twilio (WhatsApp + Voice) ----
# PUBLIC_BASE_URL is the PUBLIC webhook plane hostname (NOT the ZTNA hostname).
# Twilio calls in from the internet; ZTNA does not carry inbound webhooks.
TWILIO_ACCOUNT_SID=__CHANGE_ME__
TWILIO_AUTH_TOKEN=__CHANGE_ME__
TWILIO_WHATSAPP_FROM=whatsapp:+91__CHANGE_ME__
TWILIO_VOICE_FROM=+91__CHANGE_ME__
PUBLIC_BASE_URL=https://webhooks.example.gov.in
TWILIO_VALIDATE_SIGNATURES=true       # MUST stay true in production

# ---- LiveKit (live streaming voice) ----
# Self-host LiveKit for sovereignty; the worker connects OUTBOUND to this URL.
LIVEKIT_URL=wss://livekit.internal.example.gov.in
LIVEKIT_API_KEY=__CHANGE_ME__
LIVEKIT_API_SECRET=__CHANGE_ME__

# ---- Observability (self-hosted only — no LangSmith / US SaaS, DPDP) ----
# OTEL_TRACING=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4318
