{"agent_id": "skilling_core", "chunk_id": "pmkvy4-guidelines#s2-c1", "title": "PMKVY 4.0 Scheme Guidelines — Objective", "body": "Pradhan Mantri Kaushal Vikas Yojana 4.0 (PMKVY 4.0) enables Indian youth to take up industry-relevant NSQF-aligned skill training free of cost, covering Short Term Training (STT), Special Projects and Recognition of Prior Learning (RPL).", "language": "en-IN", "source": "MSDE (pmkvy4-guidelines vseed-0.1)", "source_url": "https://www.pmkvyofficial.org/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["scheme", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "pmkvy4-guidelines", "section": "Objective", "page": null, "chunk_hash": "sha256:f3fcc9bdaf7013906e3ef8bbb394bc6819155df9f640920e4b29458f37564c65", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["scheme:pmkvy4"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "pmkvy4-guidelines#s3-c1", "title": "PMKVY 4.0 Scheme Guidelines — Eligibility Criteria", "body": "An applicant must be an Indian national. The applicable age band for short-term training is 15 to 45 years. A valid Aadhaar and an Aadhaar-linked bank account are required for enrolment and certification.", "language": "en-IN", "source": "MSDE (pmkvy4-guidelines vseed-0.1)", "source_url": "https://www.pmkvyofficial.org/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["scheme", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "pmkvy4-guidelines", "section": "Eligibility Criteria", "page": null, "chunk_hash": "sha256:800169b4fcd226205c297c438765f352a02d872e96a5b8190efc111d5edb75dc", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["scheme:pmkvy4"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "pmkvy4-guidelines#s4-c1", "title": "PMKVY 4.0 Scheme Guidelines — Training and Certification", "body": "Training is delivered at empanelled training centres by accredited training providers. Candidates undergo assessment by designated assessment agencies and receive certification upon successful demonstration of competency. Training under the scheme is provided free of cost to eligible candidates.", "language": "en-IN", "source": "MSDE (pmkvy4-guidelines vseed-0.1)", "source_url": "https://www.pmkvyofficial.org/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["scheme", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "pmkvy4-guidelines", "section": "Training and Certification", "page": null, "chunk_hash": "sha256:7a1b501e419f12dee469eaaaaa16b3ebb933f341b8841bb5e0c478f758fe4cb6", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["scheme:pmkvy4"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "pmkvy4-guidelines#s5-c1", "title": "PMKVY 4.0 Scheme Guidelines — Documents Required", "body": "Aadhaar card, bank passbook (Aadhaar-linked account), and educational certificates as applicable to the chosen qualification.", "language": "en-IN", "source": "MSDE (pmkvy4-guidelines vseed-0.1)", "source_url": "https://www.pmkvyofficial.org/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["scheme", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "pmkvy4-guidelines", "section": "Documents Required", "page": null, "chunk_hash": "sha256:993cc6b4779ad2475af6a63d98b6e9bff31d7768e46d40ac1aa0f385ffa0e199", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["scheme:pmkvy4"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "pmkvy4-guidelines#s6-c1", "title": "PMKVY 4.0 Scheme Guidelines — Support Provisions", "body": "The scheme includes provisions for placement facilitation support and post-training handholding as notified by MSDE from time to time.", "language": "en-IN", "source": "MSDE (pmkvy4-guidelines vseed-0.1)", "source_url": "https://www.pmkvyofficial.org/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["scheme", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "pmkvy4-guidelines", "section": "Support Provisions", "page": null, "chunk_hash": "sha256:2bf131852ea2761e6aa9ffe6120249d7a18037adf57a9fff06c51e703b69fc30", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["scheme:pmkvy4"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "nsqf-descriptors#s1-c1", "title": "NSQF Level Descriptors — NSQF Level Descriptors (extract)", "body": "> SEED DOCUMENT — replace with official NCVET/NSQF notification and re-verify.", "language": "en-IN", "source": "NCVET (nsqf-descriptors vseed-0.1)", "source_url": "https://ncvet.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["policy", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "nsqf-descriptors", "section": "NSQF Level Descriptors (extract)", "page": null, "chunk_hash": "sha256:5c54b833d92e5f8deda40c9220bba65ef17de57cda03a096a02aed670d143100", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": [], "source_mode": "native", "ocr_confidence": null, "quality_flags": ["short_chunk"]}}
{"agent_id": "skilling_core", "chunk_id": "nsqf-descriptors#s2-c1", "title": "NSQF Level Descriptors — About NSQF", "body": "The National Skills Qualifications Framework (NSQF) organises qualifications in a series of levels from 1 to 10 based on professional knowledge, professional skill, core skill and responsibility.", "language": "en-IN", "source": "NCVET (nsqf-descriptors vseed-0.1)", "source_url": "https://ncvet.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["policy", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "nsqf-descriptors", "section": "About NSQF", "page": null, "chunk_hash": "sha256:b925936712d55203725d38737ea3d5ccdd797cfa5f0e10c10a2c46e07ad53c49", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": [], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "nsqf-descriptors#s3-c1", "title": "NSQF Level Descriptors — Qualification Pack", "body": "A Qualification Pack (QP) is a set of National Occupational Standards (NOS) aligned to a job role, assigned an NSQF level, and registered on the National Qualification Register (NQR) after NCVET approval.", "language": "en-IN", "source": "NCVET (nsqf-descriptors vseed-0.1)", "source_url": "https://ncvet.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["policy", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "nsqf-descriptors", "section": "Qualification Pack", "page": null, "chunk_hash": "sha256:f0fde060765deaaefdb3cbd743f76cad6e37c1066a47e661319f5e3fa7100cf9", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": [], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "nsqf-descriptors#s4-c1", "title": "NSQF Level Descriptors — Selected Level Descriptors", "body": "Level 3: Person may carry out a job which requires limited range of activities, routine and predictable, with clear choices. Level 4: Person may carry out work in familiar, predictable, routine situations of clear choice, with some responsibility for own work within defined limits. Level 5: Person may carry out a job requiring well-developed skill, with clear choice of procedures in familiar context, with responsibility for own work and some supervision of others.", "language": "en-IN", "source": "NCVET (nsqf-descriptors vseed-0.1)", "source_url": "https://ncvet.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["policy", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "nsqf-descriptors", "section": "Selected Level Descriptors", "page": null, "chunk_hash": "sha256:eceac7322686521dae73271cafffd1b6bd579dff33c2acefc9244064c9a46959", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": [], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "course-gda-01#s1-c1", "title": "Course page: GDA Certificate Course — Course: Certificate Course in General Duty Assistance (crs-gda-01)", "body": "> SEED DOCUMENT — sample course record for pipeline development (synthetic). This course prepares learners for the General Duty Assistant job role and covers Qualification Pack HSS/Q5101 (NSQF Level 4). Mode: classroom with supervised clinical practice. Indicative duration: 390 hours (approximately 3 months full-time). Supported under PMKVY 4.0 for eligible candidates — training is fee-free under the scheme. Entry requirement: Class 10 pass, minimum age 17. Assessment and certification per HSSC norms.", "language": "en-IN", "source": "SIDH catalogue (course-gda-01 vseed-0.1)", "source_url": "https://www.skillindiadigital.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["course", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "course-gda-01", "section": "Course: Certificate Course in General Duty Assistance (crs-gda-01)", "page": null, "chunk_hash": "sha256:b2d0b410c7989a2fe896dd6d7a90735772a1167facb06094dcb126e0dcb13ed2", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["course:crs-gda-01", "qp:HSS/Q5101"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "course-hha-01#s1-c1", "title": "Course page: Home Health Aide Programme — Course: Home Health Aide Skill Programme (crs-hha-01)", "body": "> SEED DOCUMENT — sample course record for pipeline development (synthetic). This programme prepares learners for the Home Health Aide job role covering Qualification Pack HSS/Q5102 (NSQF Level 3). Mode: blended (classroom + supervised home-care practice). Indicative duration: 300 hours. Supported under PMKVY 4.0 for eligible candidates. Entry requirement: Class 8 pass (Class 10 preferred), minimum age 17.", "language": "en-IN", "source": "SIDH catalogue (course-hha-01 vseed-0.1)", "source_url": "https://www.skillindiadigital.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["course", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "course-hha-01", "section": "Course: Home Health Aide Skill Programme (crs-hha-01)", "page": null, "chunk_hash": "sha256:5b5bbcb89ef5ed6230991d5df1b003daadea5462dbe733eafb9b0961c18808b0", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["course:crs-hha-01", "qp:HSS/Q5102"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "centre-registry#s1-c1", "title": "Sample training-centre metadata (SYNTHETIC) — Training Centre Registry (SYNTHETIC SAMPLE)", "body": "> SYNTHETIC DATA — fictional centres for demo. Never present as real centres. SYN Skill Centre Karol Bagh (TC-DEL-001), Central Delhi, Delhi — offers Certificate Course in General Duty Assistance (crs-gda-01). SYN Health Skills Hub Saket (TC-DEL-002), South Delhi, Delhi — offers Certificate Course in General Duty Assistance (crs-gda-01). SYN Care Academy Dwarka (TC-DEL-003), South West Delhi, Delhi — offers Home Health Aide Skill Programme (crs-hha-01). SYN MedSkill Institute Rohini (TC-DEL-004), North West Delhi, Delhi — offers Phlebotomy Technician Programme (crs-phleb-01).", "language": "en-IN", "source": "internal (centre-registry v0.1)", "source_url": "", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["course", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "centre-registry", "section": "Training Centre Registry (SYNTHETIC SAMPLE)", "page": null, "chunk_hash": "sha256:6d37c2c4946da4c4ed221dc68c19cb0347116d75fd5960a687b84ed6c4da7016", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["centre:TC-DEL-001", "centre:TC-DEL-002", "centre:TC-DEL-003", "centre:TC-DEL-004"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
