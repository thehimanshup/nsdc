{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5101#s1-c1", "title": "QP General Duty Assistant (HSS/Q5101) — QP: General Duty Assistant (HSS/Q5101)", "body": "> SEED DOCUMENT — drafted from public conventions for pipeline development. > Replace with the official NQR PDF and re-verify every fact before demo.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5101 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5101", "section": "QP: General Duty Assistant (HSS/Q5101)", "page": null, "chunk_hash": "sha256:1cb9581f60b06e6596174b78344de7a424de5749a54a48b1bd6db357671f6648", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5101"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5101#s2-c1", "title": "QP General Duty Assistant (HSS/Q5101) — Qualification Overview", "body": "The General Duty Assistant (GDA) qualification (HSS/Q5101), developed by the Healthcare Sector Skill Council (HSSC), prepares candidates to provide non-clinical patient care in hospitals and healthcare facilities. The qualification is aligned to NSQF Level 4.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5101 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5101", "section": "Qualification Overview", "page": null, "chunk_hash": "sha256:11ec5a32b6b2bdc2e6de455a9e656a1c09925f64799c72a90ca008f6e56f3ba0", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5101"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5101#s3-c1", "title": "QP General Duty Assistant (HSS/Q5101) — Eligibility", "body": "Minimum educational qualification: Class 10 pass. Minimum age: 17 years (candidates aged 15-17 may enrol under specific scheme provisions where permitted). No prior work experience is required.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5101 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5101", "section": "Eligibility", "page": null, "chunk_hash": "sha256:77d227dbac1ab2dec751783b6b31482d0ff37a07990cdcfa9fa71caa1e060c92", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5101"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5101#s4-c1", "title": "QP General Duty Assistant (HSS/Q5101) — Occupational Standards (NOS)", "body": "This Qualification Pack comprises the following National Occupational Standards: HSS/N5101 — Assist patients with daily living activities. HSS/N5102 — Monitor and record vital signs including temperature, pulse, respiration and blood pressure. HSS/N5104 — Maintain patient hygiene and follow infection control practices. HSS/N5110 — Handle biomedical waste according to prescribed protocol.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5101 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5101", "section": "Occupational Standards (NOS)", "page": null, "chunk_hash": "sha256:d35980355a16441c15a88af1b5a8a13dfb15ff7992bda32416b48628427f9231", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5101"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5101#s5-c1", "title": "QP General Duty Assistant (HSS/Q5101) — Training Duration", "body": "Indicative training duration is approximately 390 hours, covering theory, practical laboratory work and on-the-job training components.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5101 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5101", "section": "Training Duration", "page": null, "chunk_hash": "sha256:4a9befd43cf06c3676d8af24ae106c7305e9a42c6b6b01aa483eddc7a242abbb", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5101"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5101#s6-c1", "title": "QP General Duty Assistant (HSS/Q5101) — Career Progression", "body": "Certified General Duty Assistants work in hospitals, nursing homes and home-care settings. With experience and further NSQF-aligned qualifications, progression paths include senior patient-care roles and supervisory positions.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5101 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5101", "section": "Career Progression", "page": null, "chunk_hash": "sha256:87daed8f6795f17c9beb27bfc2f9ddb9a05c433238269c8f1383bedb53e916ba", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5101"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5101#s7-c1", "title": "QP General Duty Assistant (HSS/Q5101) — Assessment", "body": "Assessment covers each NOS with theory and practical components. A candidate must demonstrate competency in all NOS units to be certified.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5101 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5101", "section": "Assessment", "page": null, "chunk_hash": "sha256:734b422102576379a5cd063f7af10b691cd9f4561f6219fb0d48ba8673f373b5", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5101"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5102#s1-c1", "title": "QP Home Health Aide — QP: Home Health Aide (HSS/Q5102)", "body": "> SEED DOCUMENT — replace with official NQR PDF and re-verify before demo.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5102 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5102", "section": "QP: Home Health Aide (HSS/Q5102)", "page": null, "chunk_hash": "sha256:efa333acc8f84a94209ac6e73cac75fc4ea51dead2fea2cca722b273d8436472", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5102"], "source_mode": "native", "ocr_confidence": null, "quality_flags": ["short_chunk"]}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5102#s2-c1", "title": "QP Home Health Aide — Qualification Overview", "body": "The Home Health Aide (HHA) qualification (HSS/Q5102) by HSSC prepares candidates to deliver personal care and support services to patients in home settings. Aligned to NSQF Level 3.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5102 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5102", "section": "Qualification Overview", "page": null, "chunk_hash": "sha256:3883d5e3f1e67a4e1f4d0354798ac7bc222fa4670b4cf025fb568f5fe97c60e8", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5102"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5102#s3-c1", "title": "QP Home Health Aide — Eligibility", "body": "Minimum educational qualification: Class 8 pass (Class 10 preferred). Minimum age: 17 years.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5102 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5102", "section": "Eligibility", "page": null, "chunk_hash": "sha256:21dc9f6768d577d28ae61bfd45bdbf9195562282daff854b6c431f78d1d69713", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5102"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5102#s4-c1", "title": "QP Home Health Aide — Occupational Standards (NOS)", "body": "HSS/N5121 — Provide home-based personal care to patients. HSS/N5122 — Support mobility and comfort of patients at home.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5102 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5102", "section": "Occupational Standards (NOS)", "page": null, "chunk_hash": "sha256:cd46cae8f9c205ce2fd64d37fe3644632e737032b8e65919532eaaeb3d62c69f", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5102"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5102#s5-c1", "title": "QP Home Health Aide — Training Duration", "body": "Indicative duration approximately 300 hours, typically delivered in blended mode combining classroom and supervised home-care practice.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5102 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5102", "section": "Training Duration", "page": null, "chunk_hash": "sha256:d969e9c67a4eeb5b5de55db3916bbd4996904cb56d3073c5f67d8bef81123405", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5102"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-5102#s6-c1", "title": "QP Home Health Aide — Career Progression", "body": "Home Health Aides may progress to General Duty Assistant (HSS/Q5101, NSQF Level 4) and further patient-care qualifications.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-5102 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-5102", "section": "Career Progression", "page": null, "chunk_hash": "sha256:04e1ca1e02104f7f7e12e9b7dc962f408b993fa74e4df918a643177ec11c5a7a", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q5102"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-0301#s2-c1", "title": "QP Phlebotomy Technician — Qualification Overview", "body": "The Phlebotomy Technician qualification (HSS/Q0301) by HSSC prepares candidates to collect, label, store and transport blood specimens in laboratory and hospital settings. Aligned to NSQF Level 4.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-0301 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-0301", "section": "Qualification Overview", "page": null, "chunk_hash": "sha256:6e653fd5e71f40a4af04c215c11052c91408c03c519d6ef470067486b6bf84f0", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q0301"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-0301#s3-c1", "title": "QP Phlebotomy Technician — Eligibility", "body": "Minimum educational qualification: Class 12 pass with science subjects preferred; Class 10 pass with relevant bridge training where scheme rules permit. Minimum age: 17 years.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-0301 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-0301", "section": "Eligibility", "page": null, "chunk_hash": "sha256:5df02142c40ab7053891405d1bee071b10a1b4c308df860b0607cb70e5a3e552", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q0301"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-0301#s4-c1", "title": "QP Phlebotomy Technician — Occupational Standards (NOS)", "body": "HSS/N0301 — Collect blood specimens safely using venipuncture and capillary techniques. HSS/N0302 — Label, store and transport specimens maintaining chain of custody.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-0301 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-0301", "section": "Occupational Standards (NOS)", "page": null, "chunk_hash": "sha256:be9e94380e24579ed452f93c1cc8c975008c36e23913029fa2e5df13bf468b27", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q0301"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-0301#s5-c1", "title": "QP Phlebotomy Technician — Training Duration", "body": "Indicative duration approximately 360 hours including laboratory practice.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-0301 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-0301", "section": "Training Duration", "page": null, "chunk_hash": "sha256:f9e860b0a6f034d8ad055a0fcb682368a770a853fe919f2407493f6d3014e1f2", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q0301"], "source_mode": "native", "ocr_confidence": null, "quality_flags": ["short_chunk"]}}
{"agent_id": "skilling_core", "chunk_id": "hssc-qp-0301#s6-c1", "title": "QP Phlebotomy Technician — Career Progression", "body": "Phlebotomy Technicians work in diagnostic laboratories, hospitals and collection centres, progressing toward senior lab-technician roles with further qualifications.", "language": "en-IN", "source": "HSSC / NQR (hssc-qp-0301 vseed-0.1)", "source_url": "https://nqr.gov.in/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["qp", "healthcare"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "hssc-qp-0301", "section": "Career Progression", "page": null, "chunk_hash": "sha256:5362cbb71fc97d7464dcdd228c85b21e3b4a3436cda65c021270b25dcca8fde3", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": ["qp:HSS/Q0301"], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
