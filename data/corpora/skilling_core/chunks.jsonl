{"agent_id": "skilling_core", "chunk_id": "faq-skilling#s2-c1", "title": "Skilling FAQ compilation (from public helpdesk pages) — What is a Qualification Pack?", "body": "A Qualification Pack (QP) defines a job role through a set of National Occupational Standards (NOS) with an assigned NSQF level.", "language": "en-IN", "source": "NSDC (faq-skilling vseed-0.1)", "source_url": "https://nsdcindia.org/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["faq", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "faq-skilling", "section": "What is a Qualification Pack?", "page": null, "chunk_hash": "sha256:426959624e2debc36e271712145f06cf1dcaddab1bb62ef6dfdd87226daae44d", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": [], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "faq-skilling#s3-c1", "title": "Skilling FAQ compilation (from public helpdesk pages) — Is training under PMKVY free?", "body": "Yes — training under PMKVY 4.0 is provided free of cost to eligible candidates at empanelled centres.", "language": "en-IN", "source": "NSDC (faq-skilling vseed-0.1)", "source_url": "https://nsdcindia.org/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["faq", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "faq-skilling", "section": "Is training under PMKVY free?", "page": null, "chunk_hash": "sha256:b94f8fd51688615bb1b8a571108077333e05c83812bc56380cf4d488f173a427", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": [], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "faq-skilling#s4-c1", "title": "Skilling FAQ compilation (from public helpdesk pages) — Can I study in Hindi?", "body": "Training and assessment are available in Hindi and other regional languages at many centres, subject to centre and content availability.", "language": "en-IN", "source": "NSDC (faq-skilling vseed-0.1)", "source_url": "https://nsdcindia.org/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["faq", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "faq-skilling", "section": "Can I study in Hindi?", "page": null, "chunk_hash": "sha256:9a84aab4fe2f104d2bb141478fcd436dbdef31c501ccbb82a322f227851f886c", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": [], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
{"agent_id": "skilling_core", "chunk_id": "faq-skilling#s5-c1", "title": "Skilling FAQ compilation (from public helpdesk pages) — What happens after certification?", "body": "Certified candidates receive digitally verifiable certificates and may access placement facilitation support where provided under the scheme.", "language": "en-IN", "source": "NSDC (faq-skilling vseed-0.1)", "source_url": "https://nsdcindia.org/", "last_verified": "2026-07-19", "verified_by": "substrate-ingest", "tags": ["faq", "cross"], "state_code": "central", "uploaded_by": "substrate-ingest", "metadata": {"doc_id": "faq-skilling", "section": "What happens after certification?", "page": null, "chunk_hash": "sha256:b1c81f71257b2dddc73791d1697629dc42530dccac54babec5e4403dfc8ebcaa", "sensitivity": "public", "allowed_roles": ["learner", "officer", "sme", "admin"], "allowed_purposes": ["course_guidance", "scheme_admin", "content_qa", "evaluation"], "kg_node_ids": [], "source_mode": "native", "ocr_confidence": null, "quality_flags": []}}
