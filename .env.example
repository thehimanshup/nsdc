# =========================================================
# Phase 4b — Government Services Multi-Agent Backend
# Multi-LLM Provider Edition
# =========================================================

# ---- Deployment profile ----
# For local development, APP_ENV=development keeps demo routes and mocks available.
# For real citizens, set APP_ENV=production and keep all safety flags below locked down.
APP_ENV=development
PRODUCTION_MODE=false
ALLOW_MOCK_PROVIDERS=true
ALLOW_DEMO_ROUTES=true
AUTO_SEED_CORPORA=true
PUSH_DEMO_ENABLED=false
REQUIRE_LIVE_INTEGRATIONS=false
REQUIRE_AUTH=false
ADMIN_API_TOKEN=

# ---- LLM Provider ----
# Options: sarvam | openai | groq | together | mistral | anthropic | gemini | ollama | mock
# DEFAULT = sarvam (sovereign — Indian-hosted)
LLM_PROVIDER=sarvam

# ---- Sarvam AI (default, sovereign) ----
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_ROUTER_MODEL=sarvam-30b
SARVAM_VERIFY_SSL=true
SARVAM_CA_BUNDLE=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ---- Groq (fast OpenAI-compatible) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Together AI ----
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ---- Mistral ----
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ---- Anthropic Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# ---- Ollama (local, fully sovereign) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ---- Twilio WhatsApp + Voice ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=
PUBLIC_BASE_URL=
TWILIO_VALIDATE_SIGNATURES=true

# ---- LiveKit (live voice calls) ----
# Required for production live call support when REQUIRE_LIVE_INTEGRATIONS=true.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Server ----
HOST=127.0.0.1
PORT=8000

ENABLE_STREAMING=true
ENABLE_INTENT_ROUTER=true
DATA_DIR=./data
