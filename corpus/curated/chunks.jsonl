{"chunk_id":"hssc-qp-5101#s1-c1","doc_id":"hssc-qp-5101","section":"QP: General Duty Assistant (HSS/Q5101)","page":null,"start_ts":null,"end_ts":null,"text":"> SEED DOCUMENT — drafted from public conventions for pipeline development. > Replace with the official NQR PDF and re-verify every fact before demo.","chunk_hash":"sha256:1cb9581f60b06e6596174b78344de7a424de5749a54a48b1bd6db357671f6648","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5101"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5101#s2-c1","doc_id":"hssc-qp-5101","section":"Qualification Overview","page":null,"start_ts":null,"end_ts":null,"text":"The General Duty Assistant (GDA) qualification (HSS/Q5101), developed by the Healthcare Sector Skill Council (HSSC), prepares candidates to provide non-clinical patient care in hospitals and healthcare facilities. The qualification is aligned to NSQF Level 4.","chunk_hash":"sha256:11ec5a32b6b2bdc2e6de455a9e656a1c09925f64799c72a90ca008f6e56f3ba0","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5101"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5101#s3-c1","doc_id":"hssc-qp-5101","section":"Eligibility","page":null,"start_ts":null,"end_ts":null,"text":"Minimum educational qualification: Class 10 pass. Minimum age: 17 years (candidates aged 15-17 may enrol under specific scheme provisions where permitted). No prior work experience is required.","chunk_hash":"sha256:77d227dbac1ab2dec751783b6b31482d0ff37a07990cdcfa9fa71caa1e060c92","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5101"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5101#s4-c1","doc_id":"hssc-qp-5101","section":"Occupational Standards (NOS)","page":null,"start_ts":null,"end_ts":null,"text":"This Qualification Pack comprises the following National Occupational Standards: HSS/N5101 — Assist patients with daily living activities. HSS/N5102 — Monitor and record vital signs including temperature, pulse, respiration and blood pressure. HSS/N5104 — Maintain patient hygiene and follow infection control practices. HSS/N5110 — Handle biomedical waste according to prescribed protocol.","chunk_hash":"sha256:d35980355a16441c15a88af1b5a8a13dfb15ff7992bda32416b48628427f9231","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5101"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5101#s5-c1","doc_id":"hssc-qp-5101","section":"Training Duration","page":null,"start_ts":null,"end_ts":null,"text":"Indicative training duration is approximately 390 hours, covering theory, practical laboratory work and on-the-job training components.","chunk_hash":"sha256:4a9befd43cf06c3676d8af24ae106c7305e9a42c6b6b01aa483eddc7a242abbb","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5101"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5101#s6-c1","doc_id":"hssc-qp-5101","section":"Career Progression","page":null,"start_ts":null,"end_ts":null,"text":"Certified General Duty Assistants work in hospitals, nursing homes and home-care settings. With experience and further NSQF-aligned qualifications, progression paths include senior patient-care roles and supervisory positions.","chunk_hash":"sha256:87daed8f6795f17c9beb27bfc2f9ddb9a05c433238269c8f1383bedb53e916ba","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5101"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5101#s7-c1","doc_id":"hssc-qp-5101","section":"Assessment","page":null,"start_ts":null,"end_ts":null,"text":"Assessment covers each NOS with theory and practical components. A candidate must demonstrate competency in all NOS units to be certified.","chunk_hash":"sha256:734b422102576379a5cd063f7af10b691cd9f4561f6219fb0d48ba8673f373b5","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5101"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5102#s1-c1","doc_id":"hssc-qp-5102","section":"QP: Home Health Aide (HSS/Q5102)","page":null,"start_ts":null,"end_ts":null,"text":"> SEED DOCUMENT — replace with official NQR PDF and re-verify before demo.","chunk_hash":"sha256:efa333acc8f84a94209ac6e73cac75fc4ea51dead2fea2cca722b273d8436472","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5102"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":["short_chunk"]}
{"chunk_id":"hssc-qp-5102#s2-c1","doc_id":"hssc-qp-5102","section":"Qualification Overview","page":null,"start_ts":null,"end_ts":null,"text":"The Home Health Aide (HHA) qualification (HSS/Q5102) by HSSC prepares candidates to deliver personal care and support services to patients in home settings. Aligned to NSQF Level 3.","chunk_hash":"sha256:3883d5e3f1e67a4e1f4d0354798ac7bc222fa4670b4cf025fb568f5fe97c60e8","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5102"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5102#s3-c1","doc_id":"hssc-qp-5102","section":"Eligibility","page":null,"start_ts":null,"end_ts":null,"text":"Minimum educational qualification: Class 8 pass (Class 10 preferred). Minimum age: 17 years.","chunk_hash":"sha256:21dc9f6768d577d28ae61bfd45bdbf9195562282daff854b6c431f78d1d69713","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5102"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5102#s4-c1","doc_id":"hssc-qp-5102","section":"Occupational Standards (NOS)","page":null,"start_ts":null,"end_ts":null,"text":"HSS/N5121 — Provide home-based personal care to patients. HSS/N5122 — Support mobility and comfort of patients at home.","chunk_hash":"sha256:cd46cae8f9c205ce2fd64d37fe3644632e737032b8e65919532eaaeb3d62c69f","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5102"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5102#s5-c1","doc_id":"hssc-qp-5102","section":"Training Duration","page":null,"start_ts":null,"end_ts":null,"text":"Indicative duration approximately 300 hours, typically delivered in blended mode combining classroom and supervised home-care practice.","chunk_hash":"sha256:d969e9c67a4eeb5b5de55db3916bbd4996904cb56d3073c5f67d8bef81123405","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5102"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-5102#s6-c1","doc_id":"hssc-qp-5102","section":"Career Progression","page":null,"start_ts":null,"end_ts":null,"text":"Home Health Aides may progress to General Duty Assistant (HSS/Q5101, NSQF Level 4) and further patient-care qualifications.","chunk_hash":"sha256:04e1ca1e02104f7f7e12e9b7dc962f408b993fa74e4df918a643177ec11c5a7a","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q5102"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-0301#s2-c1","doc_id":"hssc-qp-0301","section":"Qualification Overview","page":null,"start_ts":null,"end_ts":null,"text":"The Phlebotomy Technician qualification (HSS/Q0301) by HSSC prepares candidates to collect, label, store and transport blood specimens in laboratory and hospital settings. Aligned to NSQF Level 4.","chunk_hash":"sha256:6e653fd5e71f40a4af04c215c11052c91408c03c519d6ef470067486b6bf84f0","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q0301"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-0301#s3-c1","doc_id":"hssc-qp-0301","section":"Eligibility","page":null,"start_ts":null,"end_ts":null,"text":"Minimum educational qualification: Class 12 pass with science subjects preferred; Class 10 pass with relevant bridge training where scheme rules permit. Minimum age: 17 years.","chunk_hash":"sha256:5df02142c40ab7053891405d1bee071b10a1b4c308df860b0607cb70e5a3e552","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q0301"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-0301#s4-c1","doc_id":"hssc-qp-0301","section":"Occupational Standards (NOS)","page":null,"start_ts":null,"end_ts":null,"text":"HSS/N0301 — Collect blood specimens safely using venipuncture and capillary techniques. HSS/N0302 — Label, store and transport specimens maintaining chain of custody.","chunk_hash":"sha256:be9e94380e24579ed452f93c1cc8c975008c36e23913029fa2e5df13bf468b27","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q0301"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"hssc-qp-0301#s5-c1","doc_id":"hssc-qp-0301","section":"Training Duration","page":null,"start_ts":null,"end_ts":null,"text":"Indicative duration approximately 360 hours including laboratory practice.","chunk_hash":"sha256:f9e860b0a6f034d8ad055a0fcb682368a770a853fe919f2407493f6d3014e1f2","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q0301"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":["short_chunk"]}
{"chunk_id":"hssc-qp-0301#s6-c1","doc_id":"hssc-qp-0301","section":"Career Progression","page":null,"start_ts":null,"end_ts":null,"text":"Phlebotomy Technicians work in diagnostic laboratories, hospitals and collection centres, progressing toward senior lab-technician roles with further qualifications.","chunk_hash":"sha256:5362cbb71fc97d7464dcdd228c85b21e3b4a3436cda65c021270b25dcca8fde3","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["qp:HSS/Q0301"],"index_manifest_id":"man-8061461775c1","source_org":"HSSC / NQR","source_url":"https://nqr.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"pmkvy4-guidelines#s1-c1","doc_id":"pmkvy4-guidelines","section":"PMKVY 4.0 Scheme Guidelines (extract)","page":null,"start_ts":null,"end_ts":null,"text":"> SEED DOCUMENT — drafted extract for pipeline development. Replace with the > official MSDE guidelines PDF and re-verify every criterion before demo.","chunk_hash":"sha256:be70499e3afd2c164b2983c1ef0de44a394bf61b0a54136e66f1e0e03bc88424","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["scheme:pmkvy4"],"index_manifest_id":"man-8061461775c1","source_org":"MSDE","source_url":"https://www.pmkvyofficial.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"pmkvy4-guidelines#s2-c1","doc_id":"pmkvy4-guidelines","section":"Objective","page":null,"start_ts":null,"end_ts":null,"text":"Pradhan Mantri Kaushal Vikas Yojana 4.0 (PMKVY 4.0) enables Indian youth to take up industry-relevant NSQF-aligned skill training free of cost, covering Short Term Training (STT), Special Projects and Recognition of Prior Learning (RPL).","chunk_hash":"sha256:f3fcc9bdaf7013906e3ef8bbb394bc6819155df9f640920e4b29458f37564c65","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["scheme:pmkvy4"],"index_manifest_id":"man-8061461775c1","source_org":"MSDE","source_url":"https://www.pmkvyofficial.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"pmkvy4-guidelines#s3-c1","doc_id":"pmkvy4-guidelines","section":"Eligibility Criteria","page":null,"start_ts":null,"end_ts":null,"text":"An applicant must be an Indian national. The applicable age band for short-term training is 15 to 45 years. A valid Aadhaar and an Aadhaar-linked bank account are required for enrolment and certification.","chunk_hash":"sha256:800169b4fcd226205c297c438765f352a02d872e96a5b8190efc111d5edb75dc","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["scheme:pmkvy4"],"index_manifest_id":"man-8061461775c1","source_org":"MSDE","source_url":"https://www.pmkvyofficial.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"pmkvy4-guidelines#s4-c1","doc_id":"pmkvy4-guidelines","section":"Training and Certification","page":null,"start_ts":null,"end_ts":null,"text":"Training is delivered at empanelled training centres by accredited training providers. Candidates undergo assessment by designated assessment agencies and receive certification upon successful demonstration of competency. Training under the scheme is provided free of cost to eligible candidates.","chunk_hash":"sha256:7a1b501e419f12dee469eaaaaa16b3ebb933f341b8841bb5e0c478f758fe4cb6","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["scheme:pmkvy4"],"index_manifest_id":"man-8061461775c1","source_org":"MSDE","source_url":"https://www.pmkvyofficial.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"pmkvy4-guidelines#s5-c1","doc_id":"pmkvy4-guidelines","section":"Documents Required","page":null,"start_ts":null,"end_ts":null,"text":"Aadhaar card, bank passbook (Aadhaar-linked account), and educational certificates as applicable to the chosen qualification.","chunk_hash":"sha256:993cc6b4779ad2475af6a63d98b6e9bff31d7768e46d40ac1aa0f385ffa0e199","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["scheme:pmkvy4"],"index_manifest_id":"man-8061461775c1","source_org":"MSDE","source_url":"https://www.pmkvyofficial.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"pmkvy4-guidelines#s6-c1","doc_id":"pmkvy4-guidelines","section":"Support Provisions","page":null,"start_ts":null,"end_ts":null,"text":"The scheme includes provisions for placement facilitation support and post-training handholding as notified by MSDE from time to time.","chunk_hash":"sha256:2bf131852ea2761e6aa9ffe6120249d7a18037adf57a9fff06c51e703b69fc30","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["scheme:pmkvy4"],"index_manifest_id":"man-8061461775c1","source_org":"MSDE","source_url":"https://www.pmkvyofficial.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"nsqf-descriptors#s1-c1","doc_id":"nsqf-descriptors","section":"NSQF Level Descriptors (extract)","page":null,"start_ts":null,"end_ts":null,"text":"> SEED DOCUMENT — replace with official NCVET/NSQF notification and re-verify.","chunk_hash":"sha256:5c54b833d92e5f8deda40c9220bba65ef17de57cda03a096a02aed670d143100","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":[],"index_manifest_id":"man-8061461775c1","source_org":"NCVET","source_url":"https://ncvet.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":["short_chunk"]}
{"chunk_id":"nsqf-descriptors#s2-c1","doc_id":"nsqf-descriptors","section":"About NSQF","page":null,"start_ts":null,"end_ts":null,"text":"The National Skills Qualifications Framework (NSQF) organises qualifications in a series of levels from 1 to 10 based on professional knowledge, professional skill, core skill and responsibility.","chunk_hash":"sha256:b925936712d55203725d38737ea3d5ccdd797cfa5f0e10c10a2c46e07ad53c49","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":[],"index_manifest_id":"man-8061461775c1","source_org":"NCVET","source_url":"https://ncvet.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"nsqf-descriptors#s3-c1","doc_id":"nsqf-descriptors","section":"Qualification Pack","page":null,"start_ts":null,"end_ts":null,"text":"A Qualification Pack (QP) is a set of National Occupational Standards (NOS) aligned to a job role, assigned an NSQF level, and registered on the National Qualification Register (NQR) after NCVET approval.","chunk_hash":"sha256:f0fde060765deaaefdb3cbd743f76cad6e37c1066a47e661319f5e3fa7100cf9","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":[],"index_manifest_id":"man-8061461775c1","source_org":"NCVET","source_url":"https://ncvet.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"nsqf-descriptors#s4-c1","doc_id":"nsqf-descriptors","section":"Selected Level Descriptors","page":null,"start_ts":null,"end_ts":null,"text":"Level 3: Person may carry out a job which requires limited range of activities, routine and predictable, with clear choices. Level 4: Person may carry out work in familiar, predictable, routine situations of clear choice, with some responsibility for own work within defined limits. Level 5: Person may carry out a job requiring well-developed skill, with clear choice of procedures in familiar context, with responsibility for own work and some supervision of others.","chunk_hash":"sha256:eceac7322686521dae73271cafffd1b6bd579dff33c2acefc9244064c9a46959","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":[],"index_manifest_id":"man-8061461775c1","source_org":"NCVET","source_url":"https://ncvet.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"course-gda-01#s1-c1","doc_id":"course-gda-01","section":"Course: Certificate Course in General Duty Assistance (crs-gda-01)","page":null,"start_ts":null,"end_ts":null,"text":"> SEED DOCUMENT — sample course record for pipeline development (synthetic). This course prepares learners for the General Duty Assistant job role and covers Qualification Pack HSS/Q5101 (NSQF Level 4). Mode: classroom with supervised clinical practice. Indicative duration: 390 hours (approximately 3 months full-time). Supported under PMKVY 4.0 for eligible candidates — training is fee-free under the scheme. Entry requirement: Class 10 pass, minimum age 17. Assessment and certification per HSSC norms.","chunk_hash":"sha256:b2d0b410c7989a2fe896dd6d7a90735772a1167facb06094dcb126e0dcb13ed2","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["course:crs-gda-01","qp:HSS/Q5101"],"index_manifest_id":"man-8061461775c1","source_org":"SIDH catalogue","source_url":"https://www.skillindiadigital.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"course-hha-01#s1-c1","doc_id":"course-hha-01","section":"Course: Home Health Aide Skill Programme (crs-hha-01)","page":null,"start_ts":null,"end_ts":null,"text":"> SEED DOCUMENT — sample course record for pipeline development (synthetic). This programme prepares learners for the Home Health Aide job role covering Qualification Pack HSS/Q5102 (NSQF Level 3). Mode: blended (classroom + supervised home-care practice). Indicative duration: 300 hours. Supported under PMKVY 4.0 for eligible candidates. Entry requirement: Class 8 pass (Class 10 preferred), minimum age 17.","chunk_hash":"sha256:5b5bbcb89ef5ed6230991d5df1b003daadea5462dbe733eafb9b0961c18808b0","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["course:crs-hha-01","qp:HSS/Q5102"],"index_manifest_id":"man-8061461775c1","source_org":"SIDH catalogue","source_url":"https://www.skillindiadigital.gov.in/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"centre-registry#s1-c1","doc_id":"centre-registry","section":"Training Centre Registry (SYNTHETIC SAMPLE)","page":null,"start_ts":null,"end_ts":null,"text":"> SYNTHETIC DATA — fictional centres for demo. Never present as real centres. SYN Skill Centre Karol Bagh (TC-DEL-001), Central Delhi, Delhi — offers Certificate Course in General Duty Assistance (crs-gda-01). SYN Health Skills Hub Saket (TC-DEL-002), South Delhi, Delhi — offers Certificate Course in General Duty Assistance (crs-gda-01). SYN Care Academy Dwarka (TC-DEL-003), South West Delhi, Delhi — offers Home Health Aide Skill Programme (crs-hha-01). SYN MedSkill Institute Rohini (TC-DEL-004), North West Delhi, Delhi — offers Phlebotomy Technician Programme (crs-phleb-01).","chunk_hash":"sha256:6d37c2c4946da4c4ed221dc68c19cb0347116d75fd5960a687b84ed6c4da7016","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":["centre:TC-DEL-001","centre:TC-DEL-002","centre:TC-DEL-003","centre:TC-DEL-004"],"index_manifest_id":"man-8061461775c1","source_org":"internal","source_url":null,"source_license":"synthetic","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"faq-skilling#s1-c1","doc_id":"faq-skilling","section":"Skilling FAQ (compiled extract)","page":null,"start_ts":null,"end_ts":null,"text":"> SEED DOCUMENT — compile from public NSDC/SIDH FAQ pages and re-verify.","chunk_hash":"sha256:a875d2c17c04eea52fa4ed7eb2d63a939ee8ecccb33d8bbd06d37d0116a57e6b","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":[],"index_manifest_id":"man-8061461775c1","source_org":"NSDC","source_url":"https://nsdcindia.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":["short_chunk"]}
{"chunk_id":"faq-skilling#s2-c1","doc_id":"faq-skilling","section":"What is a Qualification Pack?","page":null,"start_ts":null,"end_ts":null,"text":"A Qualification Pack (QP) defines a job role through a set of National Occupational Standards (NOS) with an assigned NSQF level.","chunk_hash":"sha256:426959624e2debc36e271712145f06cf1dcaddab1bb62ef6dfdd87226daae44d","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":[],"index_manifest_id":"man-8061461775c1","source_org":"NSDC","source_url":"https://nsdcindia.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"faq-skilling#s3-c1","doc_id":"faq-skilling","section":"Is training under PMKVY free?","page":null,"start_ts":null,"end_ts":null,"text":"Yes — training under PMKVY 4.0 is provided free of cost to eligible candidates at empanelled centres.","chunk_hash":"sha256:b94f8fd51688615bb1b8a571108077333e05c83812bc56380cf4d488f173a427","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":[],"index_manifest_id":"man-8061461775c1","source_org":"NSDC","source_url":"https://nsdcindia.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"faq-skilling#s4-c1","doc_id":"faq-skilling","section":"Can I study in Hindi?","page":null,"start_ts":null,"end_ts":null,"text":"Training and assessment are available in Hindi and other regional languages at many centres, subject to centre and content availability.","chunk_hash":"sha256:9a84aab4fe2f104d2bb141478fcd436dbdef31c501ccbb82a322f227851f886c","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":[],"index_manifest_id":"man-8061461775c1","source_org":"NSDC","source_url":"https://nsdcindia.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
{"chunk_id":"faq-skilling#s5-c1","doc_id":"faq-skilling","section":"What happens after certification?","page":null,"start_ts":null,"end_ts":null,"text":"Certified candidates receive digitally verifiable certificates and may access placement facilitation support where provided under the scheme.","chunk_hash":"sha256:b1c81f71257b2dddc73791d1697629dc42530dccac54babec5e4403dfc8ebcaa","language":"en","sensitivity":"public","allowed_roles":["learner","officer","sme","admin"],"allowed_purposes":["course_guidance","scheme_admin","content_qa","evaluation"],"kg_node_ids":[],"index_manifest_id":"man-8061461775c1","source_org":"NSDC","source_url":"https://nsdcindia.org/","source_license":"public","source_last_updated":"2026-07-19","source_mode":"native","ocr_confidence":null,"quality_flags":[]}
